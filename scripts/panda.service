[Unit]
Description=PANDA (Pin And Network-based Door Authentication) - Production Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=%USER%
WorkingDirectory=%INSTALL_DIR%
EnvironmentFile=%INSTALL_DIR%/.env
ExecStartPre=/bin/sh -c 'mkdir -p %INSTALL_DIR%/logs && touch %INSTALL_DIR%/logs/backend.log && chown -R %USER%:%USER% %INSTALL_DIR%/logs && chmod 664 %INSTALL_DIR%/logs/backend.log'
ExecStart=%INSTALL_DIR%/venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=append:%INSTALL_DIR%/logs/backend.log
StandardError=append:%INSTALL_DIR%/logs/backend.log

# Sandbox & security hardening
LimitNOFILE=65535
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
